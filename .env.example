# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control — it is in .gitignore.

# Required: your Anthropic API key
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# Optional: webhook signature secret for payload verification (recommended in production).
# Each channel (WhatsApp Business API, Booking.com, Airbnb) lets you configure a
# shared secret. Set it here and verify_signature() in main.py validates every request.
# Leave blank to skip verification in local dev mode.
WEBHOOK_SECRET=
